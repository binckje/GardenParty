# Copier en google_oauth.env (non versionné) puis remplir. Lu par scripts/dev.sh au lancement.
# Google Cloud Console > API et services : activer « Google Calendar API »,
# écran de consentement OAuth (type Externe, ton compte en utilisateur test),
# puis Identifiants > Créer un ID client OAuth :
#  - « Application de bureau » pour Linux et Android ;
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
#  - « Application Web » pour le navigateur, origine JavaScript autorisée : http://localhost:8080
GOOGLE_WEB_CLIENT_ID=
